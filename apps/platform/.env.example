# Run every platform command from apps/platform. Node.js 24+ is required.
PORT=3100
HOST=127.0.0.1
# Production defaults to loopback for a local TLS proxy; development defaults to false.
# For a remote proxy, set its exact IP/CIDR (comma-separated for a proxy chain).
# Example: TRUST_PROXY=loopback,10.0.0.10. Never trust arbitrary client forwarding headers.
TRUST_PROXY=
BASE_URL=http://localhost:3100
DATA_DIRECTORY=data
# Production requires email verification, including with TPSI_MODE=test.
# Use your own email, then register that account.
NORBY_STAFF_EMAILS=

# Development generates local secrets in data/development-secrets.json.
# Production requires separate secrets. Generate each with node:crypto randomBytes.
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
SMTP_URL=
MAIL_FROM=

# disabled | test | production. Never use production credentials for development.
TPSI_MODE=disabled
TPSI_USER_ID=
TPSI_PASSWORD=
TPSI_DEPOSIT_ACCOUNT=
# Required true in test mode. Only official fictional test-account data may be used.
# Set false for production after the official acceptance exercise.
TPSI_TEST_DATA_ONLY=false
