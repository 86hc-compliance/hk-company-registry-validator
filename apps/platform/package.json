{
  "name": "@norby/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build --mode node && esbuild server/index.ts --platform=node --format=esm --packages=external --bundle --outdir=dist/server",
    "start": "node dist/server/index.js",
    "check": "cf workers types --mode production && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write client server shared cloudflare test e2e *.ts",
    "format:check": "prettier --check client server shared cloudflare test e2e *.ts",
    "dev:cloudflare": "cf dev",
    "build:cloudflare": "cf build --mode production",
    "deploy:cloudflare": "cf deploy --mode production",
    "types:cloudflare": "cf workers types --mode production"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.16",
    "@better-auth/mcp": "1.7.16",
    "@better-auth/oauth-provider": "1.7.16",
    "@modelcontextprotocol/server": "2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "better-auth": "1.7.16",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "fast-xml-parser": "5.12.0",
    "helmet": "8.3.0",
    "lucide-react": "1.67.0",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xml-crypto": "6.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cf": "1.0.0-beta.27",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "node": "24.22.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
